{
  // Ctrl+Shift+B starts the preview server; Ctrl+click the "Server address" link
  // in the terminal to open it. Saved edits rebuild and reload the page.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview site",
      "detail": "Jekyll dev server with live reload at http://127.0.0.1:4000",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
